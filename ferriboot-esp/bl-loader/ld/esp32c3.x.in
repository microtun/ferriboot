/* Standalone flat ELF, linked for the RAM address at which Ferriboot copies it.
 * There is no ESP image header and no independent signing: these bytes are
 * embedded as rodata within Ferriboot's signed factory ESP application.
 * Address and size come from ferriboot-esp/chips/esp32c3.json, substituted
 * by build.rs. The ROM entry points below are ESP32-C3 specific.
 */
ENTRY(bl_loader_entry)
MEMORY {
    LOADER (rx) : ORIGIN = @LOADER_IRAM@, LENGTH = @LOADER_SIZE@
}
SECTIONS {
    .text ORIGIN(LOADER) : ALIGN(4) {
        KEEP(*(.text.bl_loader_entry))
        *(.text .text.*)
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)
        . = ALIGN(4);
        __loader_end = .;
    } > LOADER
    .data : { *(.data .data.* .sdata .sdata.*) } > LOADER
    .bss : { *(.bss .bss.* .sbss .sbss.* COMMON) } > LOADER
    ASSERT(SIZEOF(.data) == 0, "RAM handoff cannot contain initialized writable statics")
    ASSERT(SIZEOF(.bss) == 0, "RAM handoff cannot contain uninitialized statics")
    ASSERT(SIZEOF(.text) > 0 && SIZEOF(.text) <= LENGTH(LOADER), "loader exceeds reclaimed IRAM")
    ASSERT(ADDR(.text) == ORIGIN(LOADER), "loader entry address changed")
    ASSERT((bl_loader_trap & 0xFF) == 0, "bl_loader_trap is the C3 vectored mtvec base and must be 256-byte aligned")
    /DISCARD/ : { *(.eh_frame*) *(.comment*) }
}
/* ROM interface, ESP32-C3 ECO0+; addresses from IDF esp32c3.rom.ld. */
PROVIDE(software_reset = 0x40000090);
PROVIDE(esp_rom_spiflash_read = 0x40000130);
PROVIDE(Cache_Invalidate_ICache_All = 0x400004d8);
PROVIDE(Cache_Disable_ICache = 0x4000051c);
PROVIDE(Cache_Enable_ICache = 0x40000520);
PROVIDE(Cache_MMU_Init = 0x4000055c);
PROVIDE(Cache_Ibus_MMU_Set = 0x40000560);
PROVIDE(Cache_Dbus_MMU_Set = 0x40000564);
