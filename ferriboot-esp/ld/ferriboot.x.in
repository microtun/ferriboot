/* @generated by ferriboot-esp/build.rs from boards/<board>/layout/src/board.rs. */
MEMORY
{
    BOOT_INFO (RW) : ORIGIN = @BOOT_INFO_ADDRESS@, LENGTH = @BOOT_INFO_SIZE@
}

/* Ferriboot ESP32-C3 application linker contract; link after esp-hal's
 * linkall.x. build.rs substitutes the BOOT_INFO region from the
 * chip description.
 *
 * Boot info is the last 80 bytes of the reclaimed bootloader RAM, immediately
 * below ROM data. Startup must neither load nor zero this record;
 * .dram2_uninit allocations must end before it.
 */

EXTERN(_ferriboot_boot_info_storage);
SECTIONS {
  .ferriboot_boot_info (NOLOAD) : ALIGN(16)
  {
    _ferriboot_boot_info_start = ABSOLUTE(.);
    KEEP(*(.ferriboot_boot_info));
    _ferriboot_boot_info_end = ABSOLUTE(.);
  } > BOOT_INFO
}

ASSERT(SIZEOF(.ferriboot_boot_info) == LENGTH(BOOT_INFO), "boot info storage must fill its reservation");
ASSERT(ORIGIN(dram2_seg) + LENGTH(dram2_seg) == _ferriboot_boot_info_end,
       "boot info requires the expected ESP32-C3 reclaimed RAM map");
ASSERT(ADDR(.dram2_uninit) + SIZEOF(.dram2_uninit) <= _ferriboot_boot_info_start,
       "reclaimed RAM allocations overlap Ferriboot boot info (reserve 80 bytes)");
